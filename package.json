{
  "name": "microfrontend-training",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly React and Webpack microfrontend learning project.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "dev:shell": "npm run dev --workspace=shell",
    "dev:trade-panel-a": "npm run dev --workspace=trade-panel-a",
    "dev:trade-panel-b": "npm run dev --workspace=trade-panel-b",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  }
}
